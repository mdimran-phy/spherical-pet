# Generated vector paths and immutable teaching snapshots retain original formatting.
docs/presentations/**/assets/*.svg -whitespace linguist-generated=true
docs/presentations/**/source_snapshot/** -whitespace linguist-vendored=true
docs/presentations/**/data/** -whitespace linguist-generated=true
docs/presentations/**/presentation.html linguist-generated=true

# Documents are binary assets even when their PDF encoding contains no NUL bytes.
*.pdf binary
*.pptx binary
docs/validation/**/resolved.conf -whitespace
